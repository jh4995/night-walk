<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 표시 경로 2-C: 이 GLSurfaceView 의 GL 스레드가 OES 텍스처를 패스스루로 blit 한다. -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gl_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      ④ 시연 토글 상태 표식(B/L). 🔴 **GL 이 아니라 View 오버레이다** —
      통합 arm 의 present 패스에 드로우콜을 더하면 `detect_cpu_chain_highlight_1q` 와의
      렌더 동일성(`RenderArm.kt` 의 `_1q` 정의 — "통합 arm과 렌더가 같고 → I 하한의 분자")이
      거짓이 되고 ④ 오버레이 비용 하한의 근거가 무너진다. 여기에 GL 을 끌어들이지 마라.

      🔴 **자리는 `gl_view` 뒤 · `info_panel` 앞이다.** 설정 패널이 표식을 이겨야 한다 —
      패널을 펴는 것은 측정자의 행동이고, 그때는 표식보다 스피너가 먼저다.
      위치·크기는 코드가 정한다(`MainActivity.updateDemoHud`). 카드보드 눈 사각형은
      `CardboardGeometry` 한 곳에서만 계산되고 이 레이아웃은 그 결과를 받기만 한다.
      ⚠ `clickable=false` · `focusable=false` — 이 레이어가 정지 버튼의 터치를 먹으면
      뒤로가기로 런을 끝내게 되고 그게 곧 알려진 이슈 10 이다.
    -->
    <FrameLayout
        android:id="@+id/demo_hud_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <!-- 스마트폰(NORMAL) 모드용 1세트. -->
        <include
            android:id="@+id/demo_hud_set_normal"
            layout="@layout/demo_hud_set" />

        <!-- 카드보드 SBS 용 2세트. 🔴 **한쪽 눈만 넣지 않는다** — 한쪽에만 보이면
             참가자는 표식이 아니라 결함을 본다. -->
        <include
            android:id="@+id/demo_hud_set_left"
            layout="@layout/demo_hud_set" />

        <include
            android:id="@+id/demo_hud_set_right"
            layout="@layout/demo_hud_set" />
    </FrameLayout>

    <!--
      정보 패널. 🔴 **접을 수 있다** (아래 hud_button) — ④ 강조가 실제로 어떻게 보이는지
      촬영·캡처할 때 이 패널이 화면 절반을 가리기 때문이다.

      ⚠ 이 패널은 GLSurfaceView 와 **별 서피스**이므로 접어도 GL 스레드의 계측 창
      (t_render_start_ns ~ t_render_end_ns, GPU query)은 달라지지 않는다. 다만 지속 런에서
      컴포지션·UI 스레드 일이 줄어드는 것은 **조건 차이**라, 접힌 상태를 session.json 의
      `hud_info_hidden` 으로 남긴다 (조건을 기록하지 않고 넘기지 않는다).
    -->
    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#99000000">

        <!--
          진행 확인용 표시. ⚠ 화면 숫자는 인용 근거가 아니다 (파일로 남긴 것만 인용 가능).

          🔴 **`gone`이다 — 참가자에게 보일 화면이 아니다.** 이 패널에는 조명·arm·표시 모드
          스피너 3개만 남긴다. 측정자용 진행 표시는 logcat 과 저장된 frames.csv/session.json 으로 본다.
          ⚠ **삭제하지 말고 `gone`으로 둔다** — `MainActivity` 가 `findViewById(R.id.status_text)`
          로 lateinit 필드에 넣으므로(뷰를 지우면 `onCreate` 에서 즉사) 그리고
          `updateStatus()` 와 그 호출부 3곳(statusTicker · ③ 준비 콜백 · 정지 후)이 그대로
          살아 있어야 컴파일된다. 다시 보이게 할 때는 이 한 줄만 지운다.
        -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="@string/idle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:text="@string/lighting_label" />

        <Spinner
            android:id="@+id/lighting_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:text="@string/arm_label" />

        <!-- 렌더 arm. 조명과 같은 급의 측정 조건이라 측정 중에는 잠긴다. -->
        <Spinner
            android:id="@+id/arm_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:text="@string/display_mode_label" />

        <Spinner
            android:id="@+id/display_mode_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/cardboard_tuning_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/cardboard_fov_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/cardboard_fov_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40"
                android:progress="10" />

            <TextView
                android:id="@+id/cardboard_alignment_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/cardboard_alignment_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="120"
                android:progress="44" />
        </LinearLayout>
    </LinearLayout>

    <!--
      컨트롤 바. 🔴 **정보 패널과 갈라서 화면 아래에 둔다** — 패널을 접었을 때도
      정지 버튼에 반드시 닿아야 한다. 뒤로가기로 측정을 끝내면 flush 가 버려질 수 있어
      (알려진 이슈 10) 정지 버튼이 유일한 안전한 종료 경로다.

      🔴 **아래 여백은 코드가 시스템 인셋으로 넣는다** (MainActivity 의 control_bar 리스너).
      여기에 dp 를 박으면 3버튼 내비게이션 기기에서 버튼이 **내비바 위에 겹친다** — 실제로
      그렇게 만들었다가 정지 버튼 자리에서 홈·뒤로가 눌리는 것을 확인했다. 뒤로가가 눌리면
      그게 곧 이슈 10 이다.
      ⚠ 인셋을 **루트 FrameLayout 에 주면 안 된다** — GLSurfaceView 가 같이 줄어들어
      표시 경로의 present 기하가 바뀌고 승격 베이스라인과 비교가 끊긴다.
    -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#99000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hud_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/hud_hide" />

            <Button
                android:id="@+id/toggle_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/start" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
