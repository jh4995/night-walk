<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">밤마실</string>
    <string name="start">야간 보조 ON</string>
    <string name="stop">야간 보조 OFF</string>
    <string name="idle">잠시만 기다려 주세요\n카메라를 설정하고 있습니다</string>
    <string name="lighting_label">조명 조건 선택</string>
    <!-- ── 참가자가 읽는 문구 ────────────────────────────────────────────────
         🔴 이 아래는 **사용자 테스트 참가자**가 보는 말이다. 기술어(arm·use case·
         바인딩·프리뷰)를 쓰지 않는다. 측정자용 정밀 문장은 Kotlin 쪽에 두고
         showMessage(toast, log)의 log 인자로 보낸다 — 파일이 두 청중의 경계다.
         ⚠ 문구를 늘릴 때도 Toast 한 줄에 읽히는 길이를 넘기지 않는다. -->

    <!-- 측정 시작. 평소엔 조용하고 조명이 야외가 아닐 때만 아래 경고가 붙는다. -->
    <string name="rec_start">야간 보조를 시작합니다</string>
    <!-- 🔴 조명 기본값이 unknown이 아니게 된 것의 짝이다 — 안 고친 런이 조용히
         야간 런으로 통과하는 것을 여기서 알아챈다. 틀렸을 때만 뜬다. -->
    <string name="rec_start_lighting_warn">⚠ 조명이 %1$s 로 되어 있습니다.\n야간이면 정지하고 바꾸세요.</string>

    <!-- 볼륨키 토글(시연용). 볼륨업 = 위험물 표시, 볼륨다운 = 밝기 보정.
         🔴 **짧아야 한다** — Toast.LENGTH_LONG 이라 연타하면 큐가 밀린다.
         참가자용 어휘다: bbox·arm·셰이더 같은 말을 쓰지 않는다. -->
    <string name="demo_boxes_on">위험물 표시를 시작합니다</string>
    <string name="demo_boxes_off">위험물 표시를 종료합니다</string>
    <string name="demo_enhance_on">밝기 보정을 시작합니다</string>
    <string name="demo_enhance_off">밝기 보정을 종료합니다</string>
    <!-- 화면 우측 상단의 ④ 시연 토글 표식. 위 토스트는 **뜨고 사라지지만** 이건 남는다 —
         참가자가 지금 무엇이 켜져 있는지 언제든 눈으로 확인하는 자리다.
         🔴 **글자 하나짜리다.** 카드보드 눈 안에 들어가야 하고 저시력자가 곁눈으로도 읽어야 해서
         길이를 늘리지 않는다. 뜻은 아래 contentDescription 이 나른다(TalkBack). -->
    <string name="demo_hud_boxes_glyph">B</string>
    <string name="demo_hud_enhance_glyph">L</string>
    <!-- TalkBack 이 읽는 말. 🔴 **켜진 것만 읽힌다** — 꺼진 글자는 INVISIBLE 이라 건너뛴다.
         그래서 "…켜짐"이라고 단정해도 거짓이 되지 않는다. -->
    <string name="demo_hud_boxes_desc">위험물 표시 켜짐</string>
    <string name="demo_hud_enhance_desc">밝기 보정 켜짐</string>

    <!-- 측정 중이 아닐 때 볼륨키를 누른 경우. 키는 소비하되 아무것도 바꾸지 않는다. -->
    <string name="demo_toggle_idle">야간 보조 ON을\n먼저 눌러 주세요</string>
    <!-- 🔴 시연용 arm 이 아닐 때. **위 문구와 사유가 다르다** — 진행자가 "정지 상태라 무시"와
         "이 화면에서는 토글이 없다"를 구분해야 한다. 같은 문자열을 재사용하지 않는다. -->
    <string name="demo_toggle_wrong_arm">이 화면에서는 켜고 끌 수 없습니다</string>

    <!-- ③ 준비가 끝났다는 신호. 🔴 **시연 진행자가 이 토스트를 기다렸다 폰을 넘긴다** —
         없애면 언제 넘길지 모른다. 다만 참가자도 같은 화면을 보므로 여기에는 기술어
         (arm·ep·노드·sha256)를 쓰지 않는다. 그 원문은 showMessage 의 log 인자로만 간다.
         ⚠ **실패했을 때는 이 문자열을 쓰지 않는다** — 사유가 토스트에 그대로 떠야 한다. -->
    <string name="detect_ready">준비 완료\n야간 보조를 시작할 수 있습니다</string>

    <!-- 카메라가 아직 안 붙은 상태에서 시작을 누른 경우. -->
    <string name="camera_not_ready">카메라를 준비하는 중입니다\n잠시 후 다시 눌러 주세요</string>
    <string name="arm_label">야간 보조 방식 선택</string>
    <!--
      ④ 강조가 실제로 어떻게 보이는지 촬영·캡처할 때 정보 패널을 접는 버튼.
      ⚠ 정지 버튼은 접어도 남는다 — 뒤로가기로 끝내면 flush 가 버려진다(알려진 이슈 10).
    -->
    <string name="hud_hide">설정 OFF</string>
    <string name="hud_show">설정 ON</string>
    <string name="display_mode_label">사용 모드 선택</string>
    <string name="cardboard_fov_format">Cardboard 화면 크기: %1$d%% (작을수록 넓게 보임)</string>
    <string name="cardboard_alignment_format">좌우 상 정렬: %1$+.1f%% (− 안쪽 / + 바깥쪽)</string>
</resources>
